#!/usr/bin/env python3
"""Authenticated git for GitHub using the stored custom.github credential.

Usage: gh-git <any git arguments...>
Example: gh-git clone https://github.com/OWNER/REPO.git

Every invocation fetches a fresh credential surrogate and injects it as a
Bearer Authorization header via git's http.extraHeader (passed through
environment config, never printed or logged). The surrogate is only usable
through this machine's egress proxy, which swaps it for the real token.

Works for clone, pull, push, fetch, ls-remote on github.com URLs.
"""

import os
import subprocess
import sys

sys.path.insert(0, "/opt/hatch/skills/skill-creator/bin")
from dynamic_credentials import dynamic_credential_entry, DynamicCredentialError


def main(argv):
    if len(argv) < 2:
        print("usage: gh-git <git arguments...>", file=sys.stderr)
        return 2
    try:
        surr = dynamic_credential_entry("custom.github")["surrogate"].strip()
    except DynamicCredentialError as exc:
        print(f"credential error: {exc}", file=sys.stderr)
        return 3
    if not surr.startswith("hsurr:"):
        print("credential error: no surrogate returned", file=sys.stderr)
        return 3

    env = dict(os.environ)
    env["GIT_CONFIG_COUNT"] = "1"
    env["GIT_CONFIG_KEY_0"] = "http.extraHeader"
    env["GIT_CONFIG_VALUE_0"] = f"Authorization: Bearer {surr}"
    # never prompt; fail fast instead of hanging on auth
    env["GIT_TERMINAL_PROMPT"] = "0"

    proc = subprocess.run(["git"] + argv[1:], env=env)
    return proc.returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv))
