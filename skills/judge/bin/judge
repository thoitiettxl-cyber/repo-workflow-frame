#!/usr/bin/env python3
"""Judge CLI: structured micro-decisions via the TypeSafe System One API.

Mirrors oh-my-pi's TypeSafeJudge pattern: send {state, model, questions} to
POST {TYPESAFE_BASE_URL}/v1/systemone, verify each answer's type matches its
question, retry with backoff on 429/529.

Usage:
    judge < request.json            # read request from stdin
    judge --file request.json       # read request from file
    judge --validate < request.json # only validate the request shape
    judge --no-cache < request.json # bypass the answer cache

Cache (omp parity): answers are cached per question in SQLite at
~/.cache/judge/judgments.db (override with JUDGE_CACHE_DB), keyed by
sha256(canonical state) + model + question definition. A later request that
re-asks a question about an identical state is answered locally for free;
only unanswered questions reach the provider. The response carries a
"cached" list of question ids served from cache. Cache failures never break
a judgment; they only warn on stderr.

Request JSON: {"state": str|obj|arr, "model": "jev-latest"?, "questions": {...}}
Questions: {"<id>": {"type": "noul|choice|score", "instructions": "...",
                     "criteria": {...}}}  (criteria required for choice/score)

Env:
    TYPESAFE_API_KEY         explicit override (else the vault-stored
                             custom.typesafe connector credential is used)
    TYPESAFE_BASE_URL        default https://api.typesafe.ai
    TYPESAFE_DEFAULT_MODEL   default jev-latest

Exit codes: 0 ok | 2 usage/validation | 3 missing key | 4 provider error
"""

import hashlib
import json
import os
import sqlite3
import sys
import time
import urllib.error
import urllib.request

BASE_URL = os.environ.get("TYPESAFE_BASE_URL", "https://api.typesafe.ai").rstrip("/")
DEFAULT_MODEL = os.environ.get("TYPESAFE_DEFAULT_MODEL", "jev-latest")
CACHE_DB = os.environ.get(
    "JUDGE_CACHE_DB",
    os.path.join(os.path.expanduser("~"), ".cache", "judge", "judgments.db"),
)
MAX_RETRIES = 3

QUESTION_TYPES = ("noul", "choice", "score")

CACHE_SCHEMA = """
CREATE TABLE IF NOT EXISTS states (
    id TEXT PRIMARY KEY,
    state TEXT NOT NULL,
    created_at INTEGER NOT NULL
);
CREATE TABLE IF NOT EXISTS oracle (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    state TEXT NOT NULL REFERENCES states(id),
    model TEXT NOT NULL,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    instruction TEXT NOT NULL,
    criteria TEXT NOT NULL,
    answer TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    UNIQUE (state, model, name, type, instruction, criteria)
);
CREATE TABLE IF NOT EXISTS usage (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    state TEXT NOT NULL REFERENCES states(id),
    results TEXT NOT NULL,
    provider TEXT NOT NULL,
    model TEXT NOT NULL,
    input_tokens INTEGER NOT NULL,
    output_tokens INTEGER NOT NULL,
    created_at INTEGER NOT NULL
);
"""


def fail(code, message, detail=None):
    payload = {"error": message}
    if detail is not None:
        payload["detail"] = detail
    print(json.dumps(payload, ensure_ascii=False), file=sys.stderr)
    sys.exit(code)


def validate_request(req):
    """Local validation mirroring the API's 422 rules. Returns (model, questions)."""
    if not isinstance(req, dict):
        fail(2, "request must be a JSON object")
    if "state" not in req:
        fail(2, "request.state is required (string, object, or array)")
    questions = req.get("questions")
    if not isinstance(questions, dict) or not questions:
        fail(2, "request.questions must be a non-empty map of question id -> question")
    for qid, q in questions.items():
        if not isinstance(q, dict):
            fail(2, f"questions.{qid} must be an object")
        qtype = q.get("type")
        if qtype not in QUESTION_TYPES:
            fail(2, f"questions.{qid}.type must be one of {QUESTION_TYPES}")
        if not q.get("instructions"):
            fail(2, f"questions.{qid}.instructions is required")
        if qtype in ("choice", "score") and "criteria" not in q:
            fail(2, f"questions.{qid}.criteria is required for type '{qtype}'")
        if qtype == "choice":
            crit = q["criteria"]
            if not isinstance(crit, dict) or not crit:
                fail(2, f"questions.{qid}.criteria must be a non-empty option map")
            if len(crit) > 255:
                fail(2, f"questions.{qid}.criteria supports at most 255 options")
        if qtype == "score":
            crit = q["criteria"]
            if not isinstance(crit, list) or not (2 <= len(crit) <= 10):
                fail(2, f"questions.{qid}.criteria must be an array of 2-10 level descriptions")
    model = req.get("model") or DEFAULT_MODEL
    return model, questions


def resolve_auth(request):
    """Attach auth to the request: TYPESAFE_API_KEY env first, else the
    vault-stored custom.typesafe connector credential (surrogate Bearer).
    Returns the source used, or None when no credential is available."""
    env_key = os.environ.get("TYPESAFE_API_KEY", "").strip()
    if env_key:
        request.add_header("Authorization", f"Bearer {env_key}")
        return "env"
    try:
        sys.path.insert(0, "/opt/hatch/skills/skill-creator/bin")
        from dynamic_credentials import (
            DynamicCredentialError,
            add_surrogate_to_request,
        )
        add_surrogate_to_request(
            request, "custom.typesafe", allowed_hosts=["api.typesafe.ai"]
        )
        return "vault"
    except (ImportError, DynamicCredentialError):
        return None


def post_systemone(body):
    """POST to /v1/systemone with retry on 429/529. Returns parsed JSON."""
    data = json.dumps(body, ensure_ascii=False).encode("utf-8")
    url = f"{BASE_URL}/v1/systemone"
    last_err = None
    for attempt in range(MAX_RETRIES):
        req = urllib.request.Request(
            url,
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        auth_source = resolve_auth(req)
        if auth_source is None:
            fail(3, "No TypeSafe credential available.",
                 "Set TYPESAFE_API_KEY, or connect the typesafe provider so the "
                 "custom.typesafe vault credential can be used. "
                 "Until then, answer the question directly as the agent (text fallback).")
        try:
            with urllib.request.urlopen(req, timeout=60) as resp:
                return json.loads(resp.read().decode("utf-8"))
        except urllib.error.HTTPError as e:
            body_text = e.read().decode("utf-8", "replace")[:2000]
            if e.code == 401:
                fail(3, "TypeSafe rejected the credential (401). "
                        "Check TYPESAFE_API_KEY or reconnect the custom.typesafe provider.", body_text)
            if e.code == 422:
                fail(2, "TypeSafe rejected the request body (422).", body_text)
            if e.code in (429, 529) and attempt < MAX_RETRIES - 1:
                retry_after = e.headers.get("Retry-After")
                wait = float(retry_after) if retry_after and retry_after.isdigit() else 2 ** attempt
                time.sleep(min(wait, 30))
                last_err = f"HTTP {e.code}: {body_text}"
                continue
            fail(4, f"TypeSafe request failed: HTTP {e.code}", body_text)
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            last_err = str(e)
            if attempt < MAX_RETRIES - 1:
                time.sleep(2 ** attempt)
                continue
            fail(4, "TypeSafe request failed: network error", last_err)
    fail(4, "TypeSafe request failed after retries", last_err)


def verify_answers(questions, response):
    """Every answer must exist and its type must match its question (omp parity)."""
    if not isinstance(response, dict) or not isinstance(response.get("answers"), dict):
        fail(4, "TypeSafe returned a malformed response", response)
    answers = response["answers"]
    for qid, q in questions.items():
        ans = answers.get(qid)
        if not isinstance(ans, dict):
            fail(4, f"missing answer for question '{qid}'")
        if ans.get("type") != q["type"]:
            fail(4, f"answer type mismatch for '{qid}': "
                    f"question is '{q['type']}', answer is '{ans.get('type')}'")


def canonical_json(value):
    """Stable JSON: sorted keys, compact separators (mirrors omp's stableStringifyJson)."""
    return json.dumps(value, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False)


def warn(message):
    print(f"judge: warning: {message}", file=sys.stderr)


def cache_connect():
    """Open the cache DB (creating it). Best-effort: quarantine a corrupt file once."""
    try:
        os.makedirs(os.path.dirname(CACHE_DB), exist_ok=True)
        db = sqlite3.connect(CACHE_DB, timeout=10)
        db.executescript(CACHE_SCHEMA)
        return db
    except sqlite3.DatabaseError:
        try:
            bad = f"{CACHE_DB}.corrupt-{int(time.time())}"
            os.rename(CACHE_DB, bad)
            warn(f"cache database was corrupt; quarantined to {bad}")
            os.makedirs(os.path.dirname(CACHE_DB), exist_ok=True)
            db = sqlite3.connect(CACHE_DB, timeout=10)
            db.executescript(CACHE_SCHEMA)
            return db
        except OSError as e:
            warn(f"cache unavailable: {e}")
            return None
    except OSError as e:
        warn(f"cache unavailable: {e}")
        return None


def question_key(qid, question):
    return (
        qid,
        question["type"],
        canonical_json(question["instructions"]),
        canonical_json(question.get("criteria")),
    )


def cache_lookup(model, state, questions):
    """Return {qid: answer} already recorded for this state+model+question set."""
    db = cache_connect()
    if db is None:
        return {}
    try:
        state_json = canonical_json(state)
        state_id = hashlib.sha256(state_json.encode("utf-8")).hexdigest()
        answers = {}
        for qid, q in questions.items():
            name, qtype, instruction, criteria = question_key(qid, q)
            row = db.execute(
                "SELECT answer FROM oracle WHERE state = ? AND model = ? "
                "AND name = ? AND type = ? AND instruction = ? AND criteria = ?",
                (state_id, model, name, qtype, instruction, criteria),
            ).fetchone()
            if row:
                answers[qid] = json.loads(row[0])
        return answers
    except (sqlite3.Error, ValueError) as e:
        warn(f"cache lookup failed: {e}")
        return {}
    finally:
        db.close()


def cache_record(model, state, questions, answers, usage):
    """Record one billed request: state, one oracle row per question, one usage row."""
    db = cache_connect()
    if db is None:
        return
    try:
        now = int(time.time())
        state_json = canonical_json(state)
        state_id = hashlib.sha256(state_json.encode("utf-8")).hexdigest()
        with db:
            db.execute(
                "INSERT OR IGNORE INTO states (id, state, created_at) VALUES (?, ?, ?)",
                (state_id, state_json, now),
            )
            result_ids = []
            for qid, q in questions.items():
                name, qtype, instruction, criteria = question_key(qid, q)
                cur = db.execute(
                    """INSERT INTO oracle
                       (state, model, name, type, instruction, criteria, answer, created_at)
                       VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                       ON CONFLICT (state, model, name, type, instruction, criteria)
                       DO UPDATE SET answer = excluded.answer, created_at = excluded.created_at
                       RETURNING id""",
                    (state_id, model, name, qtype, instruction, criteria,
                     canonical_json(answers[qid]), now),
                )
                row = cur.fetchone()
                if row:
                    result_ids.append(row[0])
            db.execute(
                """INSERT INTO usage
                   (state, results, provider, model, input_tokens, output_tokens, created_at)
                   VALUES (?, ?, ?, ?, ?, ?, ?)""",
                (state_id, json.dumps(result_ids), "typesafe", model,
                 int(usage.get("input_tokens", 0)),
                 int(usage.get("output_tokens", 0)), now),
            )
    except sqlite3.Error as e:
        warn(f"cache write failed: {e}")
    finally:
        db.close()


def main(argv):
    validate_only = "--validate" in argv
    use_cache = "--no-cache" not in argv
    if "--file" in argv:
        idx = argv.index("--file")
        try:
            raw = open(argv[idx + 1], encoding="utf-8").read()
        except (IndexError, OSError) as e:
            fail(2, f"cannot read request file: {e}")
    else:
        if sys.stdin.isatty():
            fail(2, "no input: pipe a request JSON via stdin or pass --file <path>")
        raw = sys.stdin.read()
    try:
        req = json.loads(raw)
    except json.JSONDecodeError as e:
        fail(2, f"invalid JSON: {e}")

    model, questions = validate_request(req)
    if validate_only:
        print(json.dumps({"ok": True, "model": model,
                          "question_ids": list(questions)}, ensure_ascii=False))
        return

    # Per-question cache: only unanswered questions reach the provider (omp parity).
    cached_answers = cache_lookup(model, req["state"], questions) if use_cache else {}
    pending = {qid: q for qid, q in questions.items() if qid not in cached_answers}

    fresh_answers = {}
    usage = {"input_tokens": 0, "output_tokens": 0}
    provider_model = model
    if pending:
        body = {"state": req["state"], "model": model, "questions": pending}
        response = post_systemone(body)
        verify_answers(pending, response)
        fresh_answers = response["answers"]
        usage = response.get("usage", usage) or usage
        provider_model = response.get("model", model)
        if use_cache:
            cache_record(model, req["state"], pending, fresh_answers, usage)

    print(json.dumps({
        "model": provider_model,
        "answers": {**cached_answers, **fresh_answers},
        "usage": usage,
        "cached": sorted(cached_answers),
    }, ensure_ascii=False))


if __name__ == "__main__":
    main(sys.argv[1:])
