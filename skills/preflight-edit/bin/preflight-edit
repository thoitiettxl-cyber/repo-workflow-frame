#!/usr/bin/env python3
"""preflight-edit: armor around file-editing operations.

Port of the core of mitsuhiko/agent-stuff `extensions/unified-edit.ts`
(preflight validation + fuzzy edit matcher + snapshot recheck), as a
standalone CLI so agent workflows can use it without Pi Coding Agent's
extension API.

The CLI takes ONE text payload: either a row edit script or a
Codex/apply_patch-style patch.  It validates the whole plan BEFORE
touching any file (preflight), then applies with a snapshot recheck
("file changed since preflight").

Row edit script format:
    [filename]
    @OPERATION
    +insert row text
    -delete row text

Every non-header line must be clearly marked: file headers use [path],
operations use @, inserted rows use +, deleted rows use -.  To insert or
delete a real line starting with +, - or @, double the marker first
(++literal plus, --literal minus, +@decorator).  In @REPLACE, unified-diff
style context rows starting with a single space are allowed and are used
to locate a contiguous hunk; use @@ inside @REPLACE to separate hunks.

Supported row operations:
    @INS.PRE N    insert following + rows before 1-based line N
    @INS.POST N   insert following + rows after 1-based line N
    @INS.BEFORE   insert + rows before the located - anchor block
    @INS.AFTER    insert + rows after the located - anchor block
    @REPLACE      replace deleted-row blocks with inserted-row blocks;
                  - then + and + then - are both accepted
    @APPEND       append following + rows at the end of the file
    @DEL N-M      delete lines N through M inclusive (@DEL N, @DEL N..M,
                  @DEL N..=M, @DEL N.=M are accepted aliases)

Patch format (Codex apply_patch style):
    *** Begin Patch
    *** Add File: path
    +content lines
    *** Delete File: path
    *** Update File: path
    @@ optional context
     context lines / -old / +new
    *** End Patch

Usage:
    preflight-edit check [script] [--cwd DIR] [--json]
    preflight-edit apply [script] [--cwd DIR] [--json]
    script: path to a script file, or "-" / omitted to read stdin.

    check: run preflight only (dry run), never mutates files.
    apply: preflight, then apply with snapshot recheck.

Exit codes: 0 ok | 1 preflight/apply failure | 2 usage error.

Preflight failures (all raised BEFORE any file is mutated):
  - anchor text not found        -> "Could not find the exact text in ..."
  - anchor matches several spots -> "Found N occurrences ... must be unique ..."
  - empty old text / no-op edit   -> explicit error
  - overlapping edits            -> explicit error
  - file changed since preflight  -> raised at apply time, aborts that file
"""

import argparse
import difflib
import json
import os
import re
import sys
import unicodedata


# ============================================================================
# Errors
# ============================================================================

class EditError(Exception):
    """A preflight/apply failure with a message safe to show the agent."""


# ============================================================================
# Text utilities (ported from unified-edit.ts)
# ============================================================================

def normalize_to_lf(text):
    return text.replace("\r\n", "\n").replace("\r", "\n")


def detect_line_ending(content):
    crlf = content.find("\r\n")
    lf = content.find("\n")
    if lf == -1 or crlf == -1:
        return "\n"
    return "\r\n" if crlf < lf else "\n"


def restore_line_endings(text, ending):
    return text.replace("\n", "\r\n") if ending == "\r\n" else text


def normalize_for_fuzzy_match(text):
    text = unicodedata.normalize("NFKC", text)
    text = "\n".join(line.rstrip() for line in text.split("\n"))
    text = re.sub(r"[‘’‚‛]", "'", text)
    text = re.sub(r"[“”„‟]", '"', text)
    text = re.sub(r"[‐‑‒–—―−]", "-", text)
    text = re.sub(r"[  -   　]", " ", text)
    return text


def strip_bom(content):
    if content.startswith("﻿"):
        return "﻿", content[1:]
    return "", content


def split_lines_with_endings(content):
    return re.findall(r"[^\n]*\n|[^\n]+", content)


# ============================================================================
# Fuzzy edit matcher core (ported from unified-edit.ts, incl. whole-line mode)
# ============================================================================

def is_whole_line_boundary(content, start, length, old_text):
    end = start + length
    starts = start == 0 or content[start - 1] == "\n"
    ends = old_text.endswith("\n") or end >= len(content) or content[end] == "\n"
    return starts and ends


def find_match_index(content, needle, whole_lines):
    if not needle:
        return -1
    idx = content.find(needle)
    while idx != -1:
        if not whole_lines or is_whole_line_boundary(content, idx, len(needle), needle):
            return idx
        idx = content.find(needle, idx + 1)
    return -1


def fuzzy_find_text(content, old_text, whole_lines):
    """Returns dict(found, index, match_length, used_fuzzy, content_for_replacement)."""
    exact = find_match_index(content, old_text, whole_lines)
    if exact != -1:
        return {"found": True, "index": exact, "match_length": len(old_text),
                "used_fuzzy": False, "content_for_replacement": content}
    fuzzy_content = normalize_for_fuzzy_match(content)
    fuzzy_old = normalize_for_fuzzy_match(old_text)
    fuzzy_idx = find_match_index(fuzzy_content, fuzzy_old, whole_lines)
    if fuzzy_idx == -1:
        return {"found": False, "index": -1, "match_length": 0,
                "used_fuzzy": False, "content_for_replacement": content}
    return {"found": True, "index": fuzzy_idx, "match_length": len(fuzzy_old),
            "used_fuzzy": True, "content_for_replacement": fuzzy_content}


def count_needle_occurrences(content, needle, whole_lines):
    if not needle:
        return 0
    count = 0
    idx = content.find(needle)
    step_whole = whole_lines
    while idx != -1:
        if not whole_lines or is_whole_line_boundary(content, idx, len(needle), needle):
            count += 1
        idx = content.find(needle, idx + (1 if step_whole else len(needle)))
    return count


def count_occurrences(content, old_text, whole_lines):
    fuzzy_old = normalize_for_fuzzy_match(old_text)
    if not fuzzy_old:
        # A whitespace-only old_text can collapse to empty after fuzzy
        # normalization; count literally instead.
        return count_needle_occurrences(content, old_text, whole_lines)
    return count_needle_occurrences(normalize_for_fuzzy_match(content), fuzzy_old, whole_lines)


def _not_found_error(path, edit_index, total_edits):
    what = "the exact text" if total_edits == 1 else "edits[%d]" % edit_index
    noun = "old text" if total_edits == 1 else "oldText"
    return EditError(
        "Could not find %s in %s. The %s must match exactly including "
        "all whitespace and newlines." % (what, path, noun))


def _duplicate_error(path, edit_index, total_edits, occurrences):
    what = "the text" if total_edits == 1 else "edits[%d]" % edit_index
    noun = "The text" if total_edits == 1 else "Each oldText"
    return EditError(
        "Found %d occurrences of %s in %s. %s must be unique. "
        "Please provide more context to make it unique."
        % (occurrences, what, path, noun))


def _empty_old_text_error(path, edit_index, total_edits):
    if total_edits == 1:
        return EditError("oldText must not be empty in %s." % path)
    return EditError("edits[%d].oldText must not be empty in %s." % (edit_index, path))


def _no_change_error(path, total_edits):
    if total_edits == 1:
        return EditError(
            "No changes made to %s. The replacement produced identical "
            "content. This might indicate an issue with special characters "
            "or the text not existing as expected." % path)
    return EditError(
        "No changes made to %s. The replacements produced identical content." % path)


def get_line_spans(content):
    spans = []
    offset = 0
    for line in split_lines_with_endings(content):
        spans.append((offset, offset + len(line)))
        offset += len(line)
    return spans


def get_replacement_line_range(spans, match_index, match_length):
    end = match_index + match_length
    start_line = None
    for i, (s, e) in enumerate(spans):
        if s <= match_index < e:
            start_line = i
            break
    if start_line is None:
        raise EditError("Replacement range is outside the base content.")
    end_line = start_line
    while end_line < len(spans) and spans[end_line][1] < end:
        end_line += 1
    if end_line >= len(spans):
        raise EditError("Replacement range is outside the base content.")
    return start_line, end_line + 1


def apply_text_replacements(content, replacements, offset=0):
    result = content
    for r in sorted(replacements, key=lambda r: -r["match_index"]):
        i = r["match_index"] - offset
        result = result[:i] + r["new_text"] + result[i + r["match_length"]:]
    return result


def apply_replacements_preserving_unchanged_lines(original_content, base_content, replacements):
    original_lines = split_lines_with_endings(original_content)
    base_spans = get_line_spans(base_content)
    if len(original_lines) != len(base_spans):
        raise EditError("Cannot preserve unchanged lines because the base content "
                        "has a different line count.")
    groups = []
    for r in sorted(replacements, key=lambda r: r["match_index"]):
        start_line, end_line = get_replacement_line_range(
            base_spans, r["match_index"], r["match_length"])
        if groups and start_line < groups[-1]["end_line"]:
            g = groups[-1]
            g["end_line"] = max(g["end_line"], end_line)
            g["replacements"].append(r)
        else:
            groups.append({"start_line": start_line, "end_line": end_line,
                           "replacements": [r]})
    result = []
    line_idx = 0
    for g in groups:
        result.extend(original_lines[line_idx:g["start_line"]])
        gs, ge = base_spans[g["start_line"]][0], base_spans[g["end_line"] - 1][1]
        result.append(apply_text_replacements(
            base_content[gs:ge], g["replacements"], gs))
        line_idx = g["end_line"]
    result.extend(original_lines[line_idx:])
    return "".join(result)


def apply_edits_to_normalized_content(normalized_content, edits, path,
                                      require_whole_lines=False):
    """Apply (old_text -> new_text) edits. Raises EditError on any problem.

    Returns (base_content, new_content).  This is the heart of preflight:
    every failure mode (not found, duplicate, empty, overlap, no-op) raises
    before anything is written.
    """
    whole_lines = require_whole_lines is True
    norm_edits = [{"old_text": normalize_to_lf(e["old_text"]),
                   "new_text": normalize_to_lf(e["new_text"])} for e in edits]
    for i, e in enumerate(norm_edits):
        if not e["old_text"]:
            raise _empty_old_text_error(path, i, len(norm_edits))

    initial = [fuzzy_find_text(normalized_content, e["old_text"], whole_lines)
               for e in norm_edits]
    used_fuzzy = any(m["used_fuzzy"] for m in initial)
    base = (normalize_for_fuzzy_match(normalized_content)
            if used_fuzzy else normalized_content)

    matched = []
    for i, e in enumerate(norm_edits):
        m = fuzzy_find_text(base, e["old_text"], whole_lines)
        if not m["found"]:
            raise _not_found_error(path, i, len(norm_edits))
        if count_occurrences(base, e["old_text"], whole_lines) > 1:
            raise _duplicate_error(
                path, i, len(norm_edits),
                count_occurrences(base, e["old_text"], whole_lines))
        matched.append({"edit_index": i, "match_index": m["index"],
                        "match_length": m["match_length"], "new_text": e["new_text"]})

    matched.sort(key=lambda r: r["match_index"])
    for prev, cur in zip(matched, matched[1:]):
        if prev["match_index"] + prev["match_length"] > cur["match_index"]:
            raise EditError(
                "edits[%d] and edits[%d] overlap in %s. Merge them into one "
                "edit or target disjoint regions."
                % (prev["edit_index"], cur["edit_index"], path))

    if used_fuzzy:
        new_content = apply_replacements_preserving_unchanged_lines(
            normalized_content, base, matched)
    else:
        new_content = apply_text_replacements(base, matched)

    if normalized_content == new_content:
        raise _no_change_error(path, len(norm_edits))
    return normalized_content, new_content


# ============================================================================
# Row script parsing and application (ported from unified-edit.ts)
# ============================================================================

def normalize_path(path):
    trimmed = path.strip()
    if not trimmed:
        raise EditError("File path cannot be empty.")
    return trimmed[1:] if trimmed.startswith("@") else trimmed


def resolve_to_cwd(cwd, path):
    normalized = normalize_path(path)
    return os.path.normpath(normalized) if os.path.isabs(normalized) \
        else os.path.normpath(os.path.join(cwd, normalized))


def split_content(content):
    final_newline = content.endswith("\n")
    body = content[:-1] if final_newline else content
    return {"lines": [] if body == "" else body.split("\n"),
            "final_newline": final_newline}


def join_content(doc):
    body = "\n".join(doc["lines"])
    return body + "\n" if doc["final_newline"] else body


def _push_group(groups, marker, lines_to_add):
    if marker == "@@":
        groups.append({"marker": "@@", "lines": []})
        return
    if groups and groups[-1]["marker"] == marker:
        groups[-1]["lines"].extend(lines_to_add)
    else:
        groups.append({"marker": marker, "lines": list(lines_to_add)})


def parse_row_script(text):
    lines = normalize_to_lf(text).split("\n")
    files = []
    current_file = None
    current_op = None

    def finish_op():
        nonlocal current_op
        if not current_op:
            return
        if current_file is None:
            raise EditError("Internal parser error: operation without file.")
        if "rows" in current_op and not current_op["rows"]:
            raise EditError("%s in %s has no + rows."
                            % (current_op["kind"], current_file["path"]))
        if "groups" in current_op and not current_op["groups"]:
            name = {"replace": "@REPLACE",
                    "insertBeforeAnchor": "@INS.BEFORE",
                    "insertAfterAnchor": "@INS.AFTER"}[current_op["kind"]]
            raise EditError("%s in %s has no + or - rows."
                            % (name, current_file["path"]))
        current_file["ops"].append(current_op)
        current_op = None

    def require_file(line_number):
        if not current_file:
            raise EditError("Line %d: expected a [filename] header before "
                            "operations or rows." % line_number)
        return current_file

    ins_re = re.compile(r"^@INS\.(PRE|POST)\s+(\d+)\s*$", re.I)
    del_re = re.compile(r"^@DEL\s+(\d+)(?:(?:\s*-\s*|\s*\.\.=?\s*|\s*\.=\s*)(\d+))?\s*$", re.I)

    for i, raw in enumerate(lines):
        line_number = i + 1
        trimmed = raw.strip()
        if trimmed == "":
            continue

        file_match = re.match(r"^\[(.+)\]\s*$", trimmed)
        if file_match:
            finish_op()
            current_file = {"path": normalize_path(file_match.group(1)), "ops": []}
            files.append(current_file)
            continue

        if raw.startswith("@@"):
            if current_op and "groups" in current_op:
                _push_group(current_op["groups"], "@@", [])
            continue

        if raw.startswith("@"):
            require_file(line_number)
            finish_op()

            m = ins_re.match(trimmed)
            if m:
                line = int(m.group(2))
                if line < 1:
                    raise EditError("Line %d: insert line number must be >= 1."
                                    % line_number)
                current_op = {"kind": "insertBefore" if m.group(1).upper() == "PRE"
                              else "insertAfter", "line": line, "rows": []}
                continue
            if re.match(r"^@INS\.BEFORE\s*$", trimmed, re.I):
                current_op = {"kind": "insertBeforeAnchor", "groups": []}
                continue
            if re.match(r"^@INS\.AFTER\s*$", trimmed, re.I):
                current_op = {"kind": "insertAfterAnchor", "groups": []}
                continue
            if re.match(r"^@APPEND\s*$", trimmed, re.I):
                current_op = {"kind": "append", "rows": []}
                continue
            if re.match(r"^@REPLACE\s*$", trimmed, re.I):
                current_op = {"kind": "replace", "groups": []}
                continue
            m = del_re.match(trimmed)
            if m:
                start_line = int(m.group(1))
                end_line = int(m.group(2)) if m.group(2) is not None else start_line
                if start_line < 1 or end_line < start_line:
                    raise EditError("Line %d: invalid inclusive delete range %s."
                                    % (line_number, trimmed))
                current_file["ops"].append(
                    {"kind": "delete", "start_line": start_line, "end_line": end_line})
                continue
            raise EditError(
                "Line %d: unknown edit operation %s. Expected @INS.PRE, "
                "@INS.POST, @INS.BEFORE, @INS.AFTER, @REPLACE, @APPEND, or @DEL."
                % (line_number, trimmed))

        if raw.startswith("+") or raw.startswith("-"):
            require_file(line_number)
            if not current_op:
                raise EditError("Line %d: row appears before an operation."
                                % line_number)
            marker, body = raw[0], raw[1:]
            if "rows" in current_op:
                if marker != "+":
                    raise EditError("Line %d: %s only accepts + rows."
                                    % (line_number, current_op["kind"]))
                current_op["rows"].append(body)
                continue
            if "groups" not in current_op:
                raise EditError("Line %d: unexpected row for @DEL." % line_number)
            _push_group(current_op["groups"], marker, [body])
            continue

        if raw.startswith(" ") and current_op and "groups" in current_op:
            require_file(line_number)
            if current_op["kind"] == "replace":
                _push_group(current_op["groups"], " ", [raw[1:]])
            continue

        raise EditError(
            "Line %d: invalid row script line. Every non-empty row must start "
            "with [filename], @, +, -, or a space-prefixed @REPLACE context row."
            % line_number)

    finish_op()
    if not files:
        raise EditError("Row edit script must contain at least one [filename] section.")
    for f in files:
        if not f["ops"]:
            raise EditError("File section [%s] has no operations." % f["path"])
    return files


def get_contextual_replace_pairs(path, groups):
    hunks = [[]]
    for g in groups:
        if g["marker"] == "@@":
            if hunks[-1]:
                hunks.append([])
            continue
        if g["lines"]:
            hunks[-1].append(g)

    pairs = []
    for i, hunk in enumerate(hunks):
        if not hunk:
            continue
        old_lines, new_lines = [], []
        has_change = False
        for g in hunk:
            if g["marker"] == " ":
                old_lines.extend(g["lines"])
                new_lines.extend(g["lines"])
            elif g["marker"] == "-":
                old_lines.extend(g["lines"])
                has_change = True
            elif g["marker"] == "+":
                new_lines.extend(g["lines"])
                has_change = True
        label = " hunk %d" % (i + 1) if len(hunks) > 1 else ""
        if not has_change:
            raise EditError("@REPLACE%s in %s has no + or - rows." % (label, path))
        if not old_lines:
            raise EditError("@REPLACE%s in %s has + rows but no - or context "
                            "rows to locate the insertion." % (label, path))
        pairs.append({"old_lines": old_lines, "new_lines": new_lines})

    if not pairs:
        raise EditError("@REPLACE in %s has no rows." % path)
    return pairs


def get_replace_pairs(path, op):
    groups = [g for g in op["groups"] if g["marker"] == "@@" or g["lines"]]
    if not groups:
        raise EditError("@REPLACE in %s has no rows." % path)
    if any(g["marker"] in (" ", "@@") for g in groups):
        return get_contextual_replace_pairs(path, groups)

    change_groups = groups
    if len(change_groups) == 1:
        if change_groups[0]["marker"] == "-":
            return [{"old_lines": change_groups[0]["lines"], "new_lines": []}]
        raise EditError("@REPLACE in %s has + rows but no - rows to locate "
                        "the replacement." % path)
    if len(change_groups) % 2 != 0:
        raise EditError("@REPLACE in %s has an odd number of +/- blocks. Pair "
                        "each deleted block with an inserted block." % path)
    pairs = []
    for i in range(0, len(change_groups), 2):
        a, b = change_groups[i], change_groups[i + 1]
        if a["marker"] == b["marker"]:
            raise EditError("@REPLACE in %s has two adjacent %s blocks; expected "
                            "paired + and - blocks." % (path, a["marker"]))
        pairs.append({
            "old_lines": a["lines"] if a["marker"] == "-" else b["lines"],
            "new_lines": a["lines"] if a["marker"] == "+" else b["lines"],
        })
    return pairs


def row_edit_from_pair(pair, delete_whole_rows):
    old_text = "\n".join(pair["old_lines"])
    new_text = "\n".join(pair["new_lines"])
    if delete_whole_rows and not pair["new_lines"]:
        old_text += "\n"
    return {"old_text": old_text, "new_text": new_text}


def apply_replace_operation(content, path, op):
    pairs = get_replace_pairs(path, op)
    has_deletion_only = any(not p["new_lines"] for p in pairs)
    primary = [row_edit_from_pair(p, True) for p in pairs]
    try:
        return apply_edits_to_normalized_content(
            content, primary, path, require_whole_lines=True)[1]
    except EditError:
        if not has_deletion_only:
            raise
        # Deletion-only block targeting the last line of a file without a
        # trailing newline cannot match the preferred whole-row form
        # (oldText + "\n").  Fall back to replacing just the row text, still
        # requiring line boundaries.
        fallback = [row_edit_from_pair(p, False) for p in pairs]
        return apply_edits_to_normalized_content(
            content, fallback, path, require_whole_lines=True)[1]


def apply_anchor_insert_operation(content, path, op):
    name = "@INS.BEFORE" if op["kind"] == "insertBeforeAnchor" else "@INS.AFTER"
    groups = [g for g in op["groups"]
              if g["marker"] in ("+", "-") and g["lines"]]
    if len(groups) != 2 or groups[0]["marker"] == groups[1]["marker"]:
        raise EditError("%s in %s must contain exactly one - anchor block and "
                        "one + insert block." % (name, path))
    anchor = next(g for g in groups if g["marker"] == "-")
    insert = next(g for g in groups if g["marker"] == "+")
    anchor_text = "\n".join(anchor["lines"])
    insert_text = "\n".join(insert["lines"])
    new_text = (insert_text + "\n" + anchor_text
                if op["kind"] == "insertBeforeAnchor"
                else anchor_text + "\n" + insert_text)
    return apply_edits_to_normalized_content(
        content, [{"old_text": anchor_text, "new_text": new_text}],
        path, require_whole_lines=True)[1]


def apply_row_operations(path, content, ops):
    doc = split_content(content)
    for op in ops:
        kind = op["kind"]
        if kind in ("insertBefore", "insertAfter"):
            index = op["line"] - 1 if kind == "insertBefore" else op["line"]
            if index < 0 or index > len(doc["lines"]):
                name = "@INS.PRE" if kind == "insertBefore" else "@INS.POST"
                raise EditError("%s %d is outside %s; file has %d line(s)."
                                % (name, op["line"], path, len(doc["lines"])))
            doc["lines"][index:index] = op["rows"]
            if index + len(op["rows"]) == len(doc["lines"]):
                doc["final_newline"] = True
        elif kind == "append":
            doc["lines"].extend(op["rows"])
            doc["final_newline"] = True
        elif kind == "delete":
            if op["end_line"] > len(doc["lines"]):
                raise EditError("@DEL %d-%d is outside %s; file has %d line(s)."
                                % (op["start_line"], op["end_line"], path,
                                   len(doc["lines"])))
            del doc["lines"][op["start_line"] - 1:op["end_line"]]
            if not doc["lines"]:
                doc["final_newline"] = False
        elif kind in ("replace", "insertBeforeAnchor", "insertAfterAnchor"):
            if kind == "replace":
                nxt = apply_replace_operation(join_content(doc), path, op)
            else:
                nxt = apply_anchor_insert_operation(join_content(doc), path, op)
            doc = split_content(nxt)
        else:
            raise EditError("Internal error: unknown row operation %s." % kind)
    return join_content(doc)


# ============================================================================
# Patch parsing (Codex apply_patch style, ported from unified-edit.ts)
# ============================================================================

def is_patch_payload(text):
    trimmed = normalize_to_lf(text).strip()
    return trimmed.startswith("*** Begin Patch") and trimmed.endswith("*** End Patch")


def is_patch_like_payload(text):
    return normalize_to_lf(text).lstrip().startswith("*** Begin Patch")


def parse_update_chunk(lines, start, last_content_line, allow_missing_context):
    i = start
    change_context = None
    first = lines[i].rstrip()
    if first == "@@":
        i += 1
    elif first.startswith("@@ "):
        change_context = first[3:]
        i += 1
    elif not allow_missing_context:
        raise EditError("Expected update hunk to start with @@ context marker, "
                        "got: '%s'" % lines[i])

    old_lines, new_lines = [], []
    parsed = 0
    is_eof = False
    while i <= last_content_line:
        raw = lines[i]
        trimmed = raw.rstrip()
        if trimmed == "*** End of File":
            if parsed == 0:
                raise EditError("Update hunk does not contain any lines")
            is_eof = True
            i += 1
            break
        if parsed > 0 and (trimmed.startswith("@@") or trimmed.startswith("*** ")):
            break
        if len(raw) == 0:
            old_lines.append("")
            new_lines.append("")
            parsed += 1
            i += 1
            continue
        marker, body = raw[0], raw[1:]
        if marker == " ":
            old_lines.append(body)
            new_lines.append(body)
        elif marker == "-":
            old_lines.append(body)
        elif marker == "+":
            new_lines.append(body)
        elif parsed == 0:
            raise EditError("Unexpected line found in update hunk: '%s'. Every "
                            "line should start with ' ', '+', or '-'." % raw)
        else:
            break
        parsed += 1
        i += 1

    if parsed == 0:
        raise EditError("Update hunk does not contain any lines")
    return ({"change_context": change_context, "old_lines": old_lines,
             "new_lines": new_lines, "is_eof": is_eof}, i)


def parse_patch(patch_text):
    lines = normalize_to_lf(patch_text).strip().split("\n")
    if len(lines) < 2:
        raise EditError("Patch is empty or invalid")
    if lines[0].strip() != "*** Begin Patch":
        raise EditError("The first line of the patch must be '*** Begin Patch'")
    if lines[-1].strip() != "*** End Patch":
        raise EditError("The last line of the patch must be '*** End Patch'")

    ops = []
    i = 1
    last = len(lines) - 2
    while i <= last:
        if lines[i].strip() == "":
            i += 1
            continue
        line = lines[i].strip()
        if line.startswith("*** Add File: "):
            path = normalize_path(line[len("*** Add File: "):])
            i += 1
            content_lines = []
            while i <= last:
                nxt = lines[i]
                if nxt.strip().startswith("*** "):
                    break
                if not nxt.startswith("+"):
                    raise EditError("Invalid add-file line '%s'. Add file lines "
                                    "must start with '+'" % nxt)
                content_lines.append(nxt[1:])
                i += 1
            contents = "\n".join(content_lines)
            ops.append({"kind": "add", "path": path,
                        "contents": contents + "\n" if contents else ""})
            continue
        if line.startswith("*** Delete File: "):
            ops.append({"kind": "delete",
                        "path": normalize_path(line[len("*** Delete File: "):])})
            i += 1
            continue
        if line.startswith("*** Update File: "):
            path = normalize_path(line[len("*** Update File: "):])
            i += 1
            if i <= last and lines[i].strip().startswith("*** Move to: "):
                raise EditError("Patch move operations (*** Move to:) are not "
                                "supported.")
            chunks = []
            while i <= last:
                if lines[i].strip() == "":
                    i += 1
                    continue
                if lines[i].strip().startswith("*** "):
                    break
                chunk, i = parse_update_chunk(lines, i, last, len(chunks) == 0)
                chunks.append(chunk)
            if not chunks:
                raise EditError("Update file hunk for path '%s' is empty" % path)
            ops.append({"kind": "update", "path": path, "chunks": chunks})
            continue
        raise EditError("'%s' is not a valid hunk header. Valid headers: "
                        "'*** Add File:', '*** Delete File:', '*** Update File:'"
                        % line)
    return ops


def seek_sequence(lines, pattern, start, eof=False):
    if not pattern:
        return start
    if len(pattern) > len(lines):
        return None
    search_start = (len(lines) - len(pattern)) if (eof and len(lines) >= len(pattern)) \
        else max(0, start)
    search_end = len(lines) - len(pattern)
    passes = (
        lambda a, b: a == b,
        lambda a, b: a.rstrip() == b.rstrip(),
        lambda a, b: a.strip() == b.strip(),
        lambda a, b: normalize_for_fuzzy_match(a).strip()
                     == normalize_for_fuzzy_match(b).strip(),
    )
    for eq in passes:
        i = search_start
        while i <= search_end:
            if all(eq(lines[i + j], pattern[j]) for j in range(len(pattern))):
                return i
            i += 1
    return None


def derive_updated_content(file_path, current_content, chunks):
    original_lines = current_content.split("\n")
    if original_lines and original_lines[-1] == "":
        original_lines.pop()
    replacements = []
    line_index = 0
    for chunk in chunks:
        if chunk["change_context"] is not None:
            ctx = seek_sequence(original_lines, [chunk["change_context"]],
                                line_index, False)
            if ctx is None:
                raise EditError("Failed to find context '%s' in %s"
                                % (chunk["change_context"], file_path))
            line_index = ctx + 1
        if not chunk["old_lines"]:
            # Pure-insertion hunk (only `+` lines): insert at the anchor
            # position (line_index, i.e. right after the `@@` context
            # line), NOT at end of file. Lesson 2026-10-03: appending at
            # EOF misplaced 3 insert hunks into ProfileAppsScreen.kt.
            replacements.append((line_index, 0, list(chunk["new_lines"])))
            continue
        pattern = list(chunk["old_lines"])
        new_slice = list(chunk["new_lines"])
        found = seek_sequence(original_lines, pattern, line_index, chunk["is_eof"])
        if found is None and pattern and pattern[-1] == "":
            pattern = pattern[:-1]
            if new_slice and new_slice[-1] == "":
                new_slice = new_slice[:-1]
            found = seek_sequence(original_lines, pattern, line_index,
                                  chunk["is_eof"])
        if found is None:
            raise EditError("Failed to find expected lines in %s:\n%s"
                            % (file_path, "\n".join(chunk["old_lines"])))
        replacements.append((found, len(pattern), new_slice))
        line_index = found + len(pattern)

    new_lines = list(original_lines)
    for start, old_len, seg in sorted(replacements, key=lambda r: -r[0]):
        new_lines[start:start + old_len] = seg
    if not new_lines or new_lines[-1] != "":
        new_lines.append("")
    return "\n".join(new_lines)


# ============================================================================
# Plan building (snapshot store shared by row scripts and patches)
# ============================================================================

def read_existing_normalized(path, abspath):
    try:
        with open(abspath, "r", encoding="utf-8", newline="") as f:
            raw = f.read()
    except FileNotFoundError:
        raise EditError("Could not read %s (ENOENT)." % path)
    except UnicodeDecodeError:
        raise EditError("Could not read %s: not valid UTF-8 text." % path)
    if "\x00" in raw:
        raise EditError("Could not read %s: file contains null bytes." % path)
    return normalize_to_lf(strip_bom(raw)[1])


def maybe_read_normalized(abspath):
    try:
        with open(abspath, "r", encoding="utf-8", newline="") as f:
            raw = f.read()
    except FileNotFoundError:
        return None
    except UnicodeDecodeError:
        raise EditError("Could not read %s: not valid UTF-8 text." % abspath)
    if "\x00" in raw:
        raise EditError("Could not read %s: file contains null bytes." % abspath)
    return normalize_to_lf(strip_bom(raw)[1])


class SnapshotStore:
    def __init__(self, cwd, reader):
        self.cwd = cwd
        self.reader = reader
        self.snapshots = {}
        self.ordered = []

    def get(self, path):
        abspath = resolve_to_cwd(self.cwd, path)
        snap = self.snapshots.get(abspath)
        if snap is None:
            original = self.reader(path, abspath)
            snap = {"path": path, "abspath": abspath,
                    "original": original, "current": original}
            self.snapshots[abspath] = snap
            self.ordered.append(snap)
        return snap

    def collect_changes(self, no_changes_error):
        changes = []
        for snap in self.ordered:
            original, current = snap["original"], snap["current"]
            if original == current:
                continue
            if original is None and current is not None:
                changes.append({"kind": "add", "path": snap["path"],
                                "abspath": snap["abspath"],
                                "old_text": "", "new_text": current})
            elif original is not None and current is None:
                changes.append({"kind": "delete", "path": snap["path"],
                                "abspath": snap["abspath"],
                                "old_text": original, "new_text": ""})
            elif original is not None and current is not None:
                if original != current:
                    changes.append({
                        "kind": "write" if original == "" else "update",
                        "path": snap["path"], "abspath": snap["abspath"],
                        "old_text": original, "new_text": current})
        if not changes:
            raise EditError(no_changes_error)
        return changes


def build_row_plan(text, cwd):
    scripts = parse_row_script(text)
    store = SnapshotStore(cwd, read_existing_normalized)
    for script in scripts:
        snap = store.get(script["path"])
        if snap["current"] is None:
            raise EditError("Cannot edit deleted file %s." % script["path"])
        snap["current"] = apply_row_operations(
            script["path"], snap["current"], script["ops"])
    return {"mode": "rows",
            "changes": store.collect_changes("The row edit script produced no changes.")}


def build_patch_plan(text, cwd):
    operations = parse_patch(text)
    store = SnapshotStore(cwd, lambda path, abspath: maybe_read_normalized(abspath))
    for op in operations:
        snap = store.get(op["path"])
        if op["kind"] == "add":
            contents = normalize_to_lf(op["contents"])
            snap["current"] = contents if contents.endswith("\n") else contents + "\n"
        elif op["kind"] == "delete":
            if snap["current"] is None:
                raise EditError("Failed to delete %s: file does not exist."
                                % op["path"])
            snap["current"] = None
        else:
            if snap["current"] is None:
                raise EditError("Failed to update %s: file does not exist."
                                % op["path"])
            snap["current"] = derive_updated_content(
                op["path"], snap["current"], op["chunks"])
    return {"mode": "patch",
            "changes": store.collect_changes("The patch produced no changes.")}


def build_plan(text, cwd):
    if is_patch_like_payload(text):
        return build_patch_plan(text, cwd)
    return build_row_plan(text, cwd)


# ============================================================================
# Preflight and apply
# ============================================================================

def check_can_create_path(abspath):
    d = os.path.dirname(abspath) or "."
    while True:
        if os.path.isdir(d):
            if os.access(d, os.W_OK):
                return
            raise EditError("Cannot create %s: directory not writable: %s"
                            % (abspath, d))
        parent = os.path.dirname(d)
        if parent == d:
            raise EditError("Cannot create %s: no writable directory found."
                            % abspath)
        d = parent


def preflight_plan(plan):
    """Validate the whole plan. Raises EditError BEFORE anything is mutated."""
    for ch in plan["changes"]:
        if ch["kind"] == "add":
            check_can_create_path(ch["abspath"])
            continue
        if ch["kind"] == "update":
            # Re-run the transformation against the snapshot: any anchor
            # problem (not found / duplicate / no-op) fails here, not at
            # write time.
            apply_edits_to_normalized_content(
                ch["old_text"],
                [{"old_text": ch["old_text"], "new_text": ch["new_text"]}],
                ch["path"])
        if not os.access(ch["abspath"], os.R_OK | os.W_OK):
            raise EditError("Cannot access %s: need read and write permission."
                            % ch["path"])


def read_file_for_mutation(abspath):
    if not os.access(abspath, os.R_OK | os.W_OK):
        raise EditError("Cannot access %s: need read and write permission."
                        % abspath)
    with open(abspath, "r", encoding="utf-8", newline="") as f:
        raw = f.read()
    if "\x00" in raw:
        raise EditError("Cannot edit %s: file contains null bytes." % abspath)
    bom, text = strip_bom(raw)
    return {"bom": bom, "ending": detect_line_ending(text),
            "content": normalize_to_lf(text)}


def _write_file(abspath, data):
    with open(abspath, "w", encoding="utf-8", newline="") as f:
        f.write(data)


def apply_update_change(ch):
    """Patch-style update: re-derive from fresh content (snapshot recheck)."""
    f = read_file_for_mutation(ch["abspath"])
    _, new_content = apply_edits_to_normalized_content(
        f["content"],
        [{"old_text": ch["old_text"], "new_text": ch["new_text"]}],
        ch["path"])
    _write_file(ch["abspath"],
                f["bom"] + restore_line_endings(new_content, f["ending"]))
    return new_content


def apply_write_change(ch):
    """Row-script update: snapshot must still match ("changed since preflight")."""
    f = read_file_for_mutation(ch["abspath"])
    if f["content"] != ch["old_text"]:
        raise EditError("Could not edit %s: file changed since preflight."
                        % ch["path"])
    _write_file(ch["abspath"],
                f["bom"] + restore_line_endings(ch["new_text"], f["ending"]))
    return ch["new_text"]


def apply_add_change(ch):
    if os.path.lexists(ch["abspath"]):
        raise EditError("Could not add %s: file already exists." % ch["path"])
    parent = os.path.dirname(ch["abspath"])
    if parent:
        os.makedirs(parent, exist_ok=True)
    _write_file(ch["abspath"], ch["new_text"])
    return ch["new_text"]


def apply_delete_change(ch):
    if not os.access(ch["abspath"], os.R_OK | os.W_OK):
        raise EditError("Cannot access %s: need read and write permission."
                        % ch["path"])
    current = read_existing_normalized(ch["path"], ch["abspath"])
    if current != ch["old_text"]:
        raise EditError("Could not delete %s: file changed since preflight."
                        % ch["path"])
    os.unlink(ch["abspath"])
    return ""


_APPLIERS = {"update": apply_update_change, "write": apply_write_change,
             "add": apply_add_change, "delete": apply_delete_change}


def apply_plan(plan):
    results = []
    for ch in plan["changes"]:
        new_content = _APPLIERS[ch["kind"]](ch)
        results.append({"path": ch["path"], "kind": ch["kind"],
                        "old_text": ch["old_text"], "new_text": new_content})
    return results


def make_diff(path, old_text, new_text):
    return "".join(difflib.unified_diff(
        old_text.splitlines(keepends=True),
        new_text.splitlines(keepends=True),
        fromfile="a/" + path, tofile="b/" + path))


# ============================================================================
# CLI
# ============================================================================

def read_script_text(script_arg):
    if script_arg is None or script_arg == "-":
        data = sys.stdin.read()
    else:
        with open(script_arg, "r", encoding="utf-8") as f:
            data = f.read()
    if not data.strip():
        raise EditError("Edit script is empty.")
    return data


def summarize_plan(plan):
    return [{"path": ch["path"], "kind": ch["kind"]} for ch in plan["changes"]]


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="preflight-edit",
        description="Validate (preflight) and apply file edit scripts. "
                    "Preflight failures abort BEFORE any file is mutated.")
    parser.add_argument("--cwd", default=os.getcwd(),
                        help="Working directory for relative paths (default: cwd).")
    parser.add_argument("--json", action="store_true",
                        help="Machine-readable JSON output.")
    sub = parser.add_subparsers(dest="command", required=True)

    p_check = sub.add_parser("check", help="Preflight only (dry run).")
    p_check.add_argument("script", nargs="?",
                         help="Script file, or '-' / omitted for stdin.")
    p_check.add_argument("--json", action="store_true",
                         help="Machine-readable JSON output.")
    p_apply = sub.add_parser("apply", help="Preflight, then apply.")
    p_apply.add_argument("script", nargs="?",
                         help="Script file, or '-' / omitted for stdin.")
    p_apply.add_argument("--json", action="store_true",
                         help="Machine-readable JSON output.")

    args = parser.parse_args(argv)
    cwd = os.path.abspath(args.cwd)
    as_json = args.json

    def fail(message):
        if as_json:
            print(json.dumps({"ok": False, "errors": [{"message": message}]},
                             ensure_ascii=False))
        else:
            print("preflight-edit: FAILED\n  %s" % message, file=sys.stderr)
        return 1

    try:
        text = read_script_text(args.script)
        plan = build_plan(text, cwd)
        preflight_plan(plan)
    except EditError as e:
        return fail(str(e))

    files = []
    for ch in plan["changes"]:
        files.append({"path": ch["path"], "kind": ch["kind"],
                      "diff": make_diff(ch["path"], ch["old_text"], ch["new_text"])})

    if args.command == "check":
        if as_json:
            print(json.dumps({"ok": True, "mode": plan["mode"], "dry_run": True,
                              "files": files}, ensure_ascii=False))
        else:
            print("preflight-edit: PREFLIGHT OK (%d file(s), dry run, no changes made)"
                  % len(files))
            for f in files:
                print("  %s %s" % (f["kind"].upper(), f["path"]))
        return 0

    # apply
    try:
        apply_plan(plan)
    except EditError as e:
        return fail(str(e))

    if as_json:
        print(json.dumps({"ok": True, "mode": plan["mode"], "dry_run": False,
                          "files": files}, ensure_ascii=False))
    else:
        for f in files:
            verb = {"add": "Added", "delete": "Deleted"}.get(f["kind"], "Edited")
            print("%s %s" % (verb, f["path"]))
        if len(files) > 1:
            print("Applied preflight-edit to %d file(s)." % len(files))
    return 0


if __name__ == "__main__":
    sys.exit(main())
